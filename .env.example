# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: enables the real web_search tool instead of its stub response.
TAVILY_API_KEY=

# Model routing (see agent_orchestrator/config.py for defaults)
SUPERVISOR_MODEL=claude-sonnet-5
REVIEWER_MODEL=claude-sonnet-5
SPECIALIST_MODEL=gpt-5

# Thresholds
PLAN_CONFIDENCE_THRESHOLD=0.6
REVIEW_SCORE_THRESHOLD=0.7
MAX_SPECIALIST_RETRIES=2
MAX_REVIEW_CYCLES=2

# Sandbox for file + code-execution tools
SANDBOX_WORKDIR=./sandbox
CODE_EXECUTION_TIMEOUT_SECONDS=10

# Short-term working memory (needs a running Redis instance)
REDIS_URL=redis://localhost:6379/0
WORKING_MEMORY_TTL_SECONDS=3600

# Long-term semantic memory (ChromaDB). "persistent" (default) writes to a
# local directory, no server needed. docker-compose sets this to "http" to
# talk to the chroma service instead -- see CHROMA_HOST/CHROMA_PORT below.
CHROMA_MODE=persistent
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8000
MEMORY_COLLECTION_NAME=task_memories
MEMORY_TOP_K=3
MEMORY_IMPORTANCE_HALF_LIFE_DAYS=30
MEMORY_MIN_IMPORTANCE=0.05
MEMORY_MIN_AGE_DAYS_BEFORE_EXPIRY=7
MEMORY_CONSOLIDATION_SIMILARITY_THRESHOLD=0.93

# Observability (Phase 4): trace/cost store, checkpoint persistence, OTel
TRACE_DB_PATH=./traces.db
CHECKPOINT_DB_PATH=./checkpoints.db
OTEL_SERVICE_NAME=agent-orchestrator
OTEL_CONSOLE_EXPORT=true
# Set to send spans to a real collector (Jaeger, Honeycomb, etc.) too.
OTEL_EXPORTER_OTLP_ENDPOINT=
# MODEL_PRICING overrides agent_orchestrator/config.py's illustrative
# placeholder $/1M-token rates -- pass as a JSON object, e.g.
# MODEL_PRICING={"gpt-5": {"input_per_million": 5.0, "output_per_million": 15.0}}

# Phase 5: containerized deployment. All optional -- unset, the system runs
# entirely from local files/in-process execution (what running the CLI
# directly on your machine does); docker-compose.yml sets all of these.
POSTGRES_URL=
USE_CELERY_FOR_SPECIALISTS=false
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
