# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: enables the real web_search tool instead of its stub response.
TAVILY_API_KEY=

# Model routing (see agent_orchestrator/config.py for defaults)
SUPERVISOR_MODEL=claude-sonnet-5
REVIEWER_MODEL=claude-sonnet-5
SPECIALIST_MODEL=gpt-5

# Thresholds
PLAN_CONFIDENCE_THRESHOLD=0.6
REVIEW_SCORE_THRESHOLD=0.7
MAX_SPECIALIST_RETRIES=2
MAX_REVIEW_CYCLES=2

# Sandbox for file + code-execution tools
SANDBOX_WORKDIR=./sandbox
CODE_EXECUTION_TIMEOUT_SECONDS=10

# Short-term working memory (needs a running Redis instance)
REDIS_URL=redis://localhost:6379/0
WORKING_MEMORY_TTL_SECONDS=3600

# Long-term semantic memory (ChromaDB, persisted to disk -- no server needed)
CHROMA_PERSIST_DIR=./chroma_data
MEMORY_COLLECTION_NAME=task_memories
MEMORY_TOP_K=3
MEMORY_IMPORTANCE_HALF_LIFE_DAYS=30
MEMORY_MIN_IMPORTANCE=0.05
MEMORY_MIN_AGE_DAYS_BEFORE_EXPIRY=7
MEMORY_CONSOLIDATION_SIMILARITY_THRESHOLD=0.93
